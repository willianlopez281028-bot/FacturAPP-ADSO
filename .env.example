FLASK_DEBUG=1
SECRET_KEY=change-this-for-local-development

# Configuración MySQL (copiar a .env y completar localmente)
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_contrasena_mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=factureapp

# Debe coincidir con un valor permitido en users.role.
# El inicio de sesión aún no está implementado; el módulo de usuarios
# permanece bloqueado hasta que exista una sesión administrativa real.
ADMIN_ROLE_VALUE=ADMIN
